#!/bin/bash
unset IFS
set -eufo pipefail

SQUEEZE_VERSION='0.0.1'

usage() {
    printf "Usage: %s [OPTIONS] <path>\n" "$0"
    printf "\n"
    printf -- "-v\tShow version info\n"
    printf -- "-h\tShow usage menu\n"
}

banner() {
    printf "%s\n" "$SQUEEZE_VERSION"
}

SOURCE_EXTENSIONS=(
    'bmp'
    'jpg'
    'gif'
    'png'
)
TARGET_EXTENSION='webp'
ALL_EXTENSIONS=("${SOURCE_EXTENSIONS[@]}")
ALL_EXTENSIONS+=("$TARGET_EXTENSION")

PADDING='4'
MAX_CHILD_FILES='9999'

while [ "$#" -ge 1 ]; do
    case "$1" in
    '-v')
        shift
        banner
        exit
        ;;
    '-h')
        shift
        usage
        exit
        ;;
    *)
        break
        ;;
    esac
done

total_child_files="$(find . -type f | wc -l)"

if [ "$total_child_files" -gt "$MAX_CHILD_FILES" ]; then
    echo "error: working directory contains > $MAX_CHILD_FILES files"
    exit 1
fi

for EXTENSION in "${ALL_EXTENSIONS[@]}"; do
    find \
        . \
        -type f \
        -iname "*.${EXTENSION}" \
        -exec rename "s/(\\d+)(?=\\.\\w+$)/sprintf(\"%0${PADDING}d\", \$1)/e" "{}" \+
done

for EXTENSION in "${SOURCE_EXTENSIONS[@]}"; do
    find . -type f -iname "*.${EXTENSION}" -print0 | while IFS= read -r -d $'\0' f; do
        b="$(basename "$f" ".${EXTENSION}")"
        c="${b}.${TARGET_EXTENSION}"
        magick "$f" "$c"
    done

    find \
        . \
        -type f \
        -iname "*.${EXTENSION}" \
        -delete
done

d="$(basename "$(pwd)")"

find \
    . \
    -type f |
    sort |
    zip ../"${d}.cbz" -@

find \
    . \
    -type f \
    \( -name .DS_Store -o -name Thumbs.db \) \
    -delete
