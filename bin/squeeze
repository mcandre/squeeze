#!/bin/bash
unset IFS
set -eufo pipefail

SQUEEZE_VERSION='0.0.2'
EXCLUDE_GLOBS=(
    '.DS_Store'
    'Thumbs.db'
)

usage() {
    printf "Usage: %s [OPTIONS] <path> [<path> [<path> ...]]\n" "$0"
    printf "\n"
    printf -- "-a\t\tEnable author normalization\n"
    printf -- "-x <glob>\tAppend file path exclusion. Default: (%s)\n" "${EXCLUDE_GLOBS[*]}"
    printf -- "-d\t\tEnable additional logging\n"
    printf -- "-v\t\tShow version info\n"
    printf -- "-h\t\tShow usage menu\n"
}

banner() {
    printf "%s\n" "$SQUEEZE_VERSION"
}

SQUEEZE_SUFFIX='.fresh.cbz'
DEBUG='0'
AUTHOR_NORMALIZATION='0'

SOURCE_EXTENSIONS=(
    'apng'
    'avif'
    'bmp'
    'gif'
    'heic'
    'heif'
    'jng'
    'jpeg'
    'jpg'
    'jxl'
    'png'
    'pnj'
    'tif'
    'tiff'
)
TARGET_EXTENSION='webp'
ALL_EXTENSIONS=("${SOURCE_EXTENSIONS[@]}")
ALL_EXTENSIONS+=("$TARGET_EXTENSION")

while [ "$#" -ge 1 ]; do
    case "$1" in
    '-d')
        shift
        DEBUG='1'
        ;;
    '-a')
        shift
        AUTHOR_NORMALIZATION='1'
        ;;
    '-x')
        shift
        GLOB="$1"
        shift
        EXCLUDE_GLOBS+=("$GLOB")
        ;;
    '-v')
        shift
        banner
        exit
        ;;
    '-h')
        shift
        usage
        exit
        ;;
    *)
        break
        ;;
    esac
done

freshen() {
    source_archive="$1"
    shopt -s nocasematch

    if ! [[ "$source_archive" =~ ^.*\.(cbz|zip)$ ]]; then
        echo "error: unsupported archive file type: $source_archive"
        return 1
    fi

    echo "info: freshening: $source_archive"

    t="$(mktemp -d)"

    if [[ "$DEBUG" -eq '1' ]]; then
        echo "debug: temp dir: $t"
    fi

    source_archive_normalized="$source_archive"
    source_archive_normalized_basename="$(basename "$source_archive")"

    if [[ "$AUTHOR_NORMALIZATION" -eq '1' && "$source_archive" =~ ^\[([^\]]+)\]\ (.*)$ ]]; then
        author="${BASH_REMATCH[1]}"
        rest="${BASH_REMATCH[2]}"
        author_train_case="${author// /-}"
        author_lower_train_case="$(echo "$author_train_case" | tr '[:upper:]' '[:lower:]')"
        source_archive_normalized_basename="${author_lower_train_case} - ${rest}"

        if [[ "$DEBUG" -eq '1' ]]; then
            echo "debug: archive author normalized: $source_archive_normalized_basename"
        fi

        source_archive_normalized="${t}/${source_archive_normalized_basename}"
        cp "$source_archive" "$source_archive_normalized"
    fi

    source_dir="${t}/${source_archive_normalized_basename%.*}"

    unzip \
        "$source_archive_normalized" \
        -d "$source_dir" >/dev/null

    if [[ "$DEBUG" -eq '1' ]]; then
        echo "debug: extracted source dir: $source_dir"
    fi

    total_child_files="$(find "$source_dir" -type f | wc -l)"
    padding="$(echo "scale=10; val = l($total_child_files)/l(10); scale=0; if (val > 0 && val != val/1) val/1 + 1 else val/1" | bc -l)"

    for EXTENSION in "${ALL_EXTENSIONS[@]}"; do
        find \
            "$source_dir" \
            -type f \
            -iname "*.${EXTENSION}" \
            -exec rename "s/(\\d+)(?=\\.\\w+$)/sprintf(\"%0${padding}d\", \$1)/e" "{}" \+
    done

    for EXTENSION in "${SOURCE_EXTENSIONS[@]}"; do
        find "$source_dir" -type f -iname "*.${EXTENSION}" -print0 | while IFS= read -r -d $'\0' f; do
            b="${f%."${EXTENSION}"}"
            c="${b}.${TARGET_EXTENSION}"
            magick "$f" "$c"
        done

        find \
            "$source_dir" \
            -type f \
            -iname "*.${EXTENSION}" \
            -delete
    done

    target_archive="$(dirname -- "$(realpath "$source_archive")")/${source_archive_normalized_basename%.*}${SQUEEZE_SUFFIX}"
    pushd "$source_dir" >/dev/null
    find \
        . \
        -type f |
        sort |
        zip \
            -x "${EXCLUDE_GLOBS[@]}" \
            -@ \
            "$target_archive" >/dev/null

    popd >/dev/null
    rm -rf "$t"
}

if [ "$#" -eq 0 ]; then
    usage
    exit 1
fi

for pth in "$@"; do
    freshen "$pth"
done
